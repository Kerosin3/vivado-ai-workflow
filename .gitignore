build/**
!build/**/
!build/**/*.mcs

# Vivado session logs/journals/temp cache
.Xil/
*.jou
*.log
*.backup.jou
*.backup.log
*.str
webtalk*.log
webtalk*.jou

# Claude Code local, per-user settings
.claude/settings.local.json
.claude/settings.local.json.tmp.*
