# Vivado project build output — regenerated by tcl/build_*.tcl.
# Exception: .mcs (flash config memory) files are tracked.
build/**
!build/**/
!build/**/*.mcs

# Same, for the Docker build flow's isolated project tree (BUILD_DIR=./build-docker)
build-docker/**
!build-docker/**/
!build-docker/**/*.mcs

# Vivado session logs/journals/temp cache
.Xil/
*.jou
*.log
*.backup.jou
*.backup.log
*.str
webtalk*.log
webtalk*.jou
hs_err_pid*.log

# Claude Code local, per-user settings
.claude/settings.local.json
.claude/settings.local.json.tmp.*
